{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Second Brain Cluster Librarian Bundle v1",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "cluster_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "cluster_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "source_dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "source_note": {
            "type": "string",
            "pattern": "^50_Sources/.+\\.md$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "knowledge",
              "reference",
              "administrative",
              "low_information"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900
          }
        },
        "required": [
          "source_note",
          "disposition",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "knowledge_actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update"
            ]
          },
          "target_note": {
            "type": "string",
            "pattern": "^30_Knowledge/.+\\.md$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "body_markdown": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "source_notes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^50_Sources/.+\\.md$"
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "action",
          "target_note",
          "title",
          "summary",
          "body_markdown",
          "source_notes",
          "tags",
          "confidence",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 300
          },
          "to": {
            "type": "string",
            "maxLength": 300
          },
          "relation": {
            "type": "string",
            "enum": [
              "supports",
              "derives",
              "related_to",
              "part_of",
              "contradicts",
              "extends",
              "source_for",
              "generalizes",
              "specializes",
              "uses"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        },
        "required": [
          "from",
          "to",
          "relation",
          "confidence",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "area_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create_moc",
            "update_moc",
            "none"
          ]
        },
        "target_note": {
          "type": "string",
          "maxLength": 300
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 1800
        },
        "member_notes": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "action",
        "target_note",
        "title",
        "description",
        "member_notes",
        "confidence",
        "reason"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "maxLength": 1800
    }
  },
  "required": [
    "version",
    "cluster_id",
    "cluster_title",
    "source_dispositions",
    "knowledge_actions",
    "links",
    "area_action",
    "notes"
  ],
  "additionalProperties": false
}